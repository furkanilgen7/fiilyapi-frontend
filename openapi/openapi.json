  "components": {
    "schemas": {
      "AccessLevel": {
        "type": "string",
        "enum": [
          "none",
          "view",
          "draft",
          "request",
          "approve",
          "full",
          "admin"
        ],
        "title": "AccessLevel",
        "description": "Erişim seviyesi. Sıralıdır: none < view < draft < request < approve < full < admin.\n\nfull silmeyi KAPSAMAZ — silme yalnızca admin seviyesindedir (spec §5.0)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
